{
  "name": "life-lanes",
  "version": "0.1.0",
  "private": true,
  "description": "A calm personal board for notes, priorities, and the different areas of life.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "tsc --noEmit --pretty false",
    "test:e2e": "playwright test --config=playwright.served.config.ts",
    "test:e2e:live": "playwright test",
    "test:e2e:ui": "playwright test --ui --config=playwright.served.config.ts",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}
